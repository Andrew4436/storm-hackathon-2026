# Copy to backend/.env (gitignored) and load it with:
#   uvicorn backend.app:app --reload --port 8000 --env-file backend/.env
# On a host (Render, Railway, Fly), set these as environment variables instead.

# Folder with forecast_YYYY-MM.json, history.json and (optional) meta.json.
# Absolute, or relative to the repo root. Default: ml/outputs
ML_OUTPUTS_DIR=ml/outputs

# Exact origins allowed to call the API from a browser, comma-separated, no trailing slash.
# Add the deployed frontend's origin here if it is not on github.io or vercel.app.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: a regex (full match) for more origins. The default allows any
# https://<name>.github.io and https://<name>.vercel.app origin.
# ALLOWED_ORIGIN_REGEX=https://[A-Za-z0-9.-]+\.github\.io|https://[A-Za-z0-9.-]+\.vercel\.app
